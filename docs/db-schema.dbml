// ============================================================
// АУТЕНТИФИКАЦИЯ
// ============================================================

Table users {
  id            BIGSERIAL   [pk]
  email         TEXT        [not null, unique]
  name          TEXT        [not null]
  password_hash TEXT        [not null]
  created_at    TIMESTAMPTZ [not null, default: `NOW()`]
  updated_at    TIMESTAMPTZ [not null, default: `NOW()`]
}

Table refresh_tokens {
  id         BIGSERIAL   [pk]
  user_id    BIGINT      [not null, ref: > users.id]
  token_hash TEXT        [not null, unique]
  expires_at TIMESTAMPTZ [not null]
  revoked_at TIMESTAMPTZ
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    user_id
    expires_at
  }

  Note: 'ON DELETE CASCADE на user_id'
}

// ============================================================
// СПРАВОЧНИКИ
// ============================================================

Table countries {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'countries_name_ci']
  }
}

Table languages {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'languages_name_ci']
  }
}

Table professions {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'professions_name_ci']
  }
}

Table hair_colors {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'hair_colors_name_ci']
  }
}

Table eye_colors {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    `lower(name)` [unique, name: 'eye_colors_name_ci']
  }
}

Table cities {
  id         BIGSERIAL   [pk]
  name       TEXT        [not null]
  country_id BIGINT      [not null, ref: > countries.id]
  created_at TIMESTAMPTZ [not null, default: `NOW()`]

  indexes {
    (`lower(name)`, country_id) [unique, name: 'cities_name_ci']
  }
}

// ============================================================
// ПРЕСТУПНИКИ
// ============================================================

Table criminals {
  id             BIGSERIAL [pk]
  last_name      TEXT      [not null]
  first_name     TEXT      [not null]
  nickname       TEXT
  height_cm      INT
  has_hair       BOOLEAN   [not null, default: true]
  hair_color_id  BIGINT    [ref: >? hair_colors.id]
  eye_color_id   BIGINT    [ref: >? eye_colors.id]
  birth_date     DATE
  birth_city_id  BIGINT    [ref: >? cities.id]
  last_city_id   BIGINT    [ref: >? cities.id]
  notes          TEXT

  Note: '''
  CHECK (height_cm IS NULL OR height_cm BETWEEN 30 AND 280)
  CHECK (
    (has_hair = TRUE  AND hair_color_id IS NOT NULL) OR
    (has_hair = FALSE AND hair_color_id IS NULL)
  )
  При has_hair = FALSE цвет волос = NULL (нет волос).
  При has_hair = TRUE и hair_color_id IS NULL — цвет неизвестен.
  '''

  indexes {
    (last_name, first_name)
    nickname
    height_cm
    hair_color_id
    eye_color_id
    birth_date
    birth_city_id
    last_city_id
  }
}

// ============================================================
// СВЯЗИ M:N
// ============================================================

Table criminal_languages {
  criminal_id BIGINT [not null, ref: > criminals.id]
  language_id BIGINT [not null, ref: > languages.id]
  level       TEXT

  indexes {
    (criminal_id, language_id) [pk]
  }

  Note: '''
  CHECK (level IN ('A1','A2','B1','B2','C1','C2'))
  ON DELETE CASCADE
  '''
}

Table citizenships {
  criminal_id BIGINT [not null, ref: > criminals.id]
  country_id  BIGINT [not null, ref: > countries.id]

  indexes {
    (criminal_id, country_id) [pk]
  }

  Note: 'ON DELETE CASCADE'
}

Table criminal_professions {
  criminal_id  BIGINT [not null, ref: > criminals.id]
  profession_id BIGINT [not null, ref: > professions.id]

  indexes {
    (criminal_id, profession_id) [pk]
  }

  Note: 'ON DELETE CASCADE'
}